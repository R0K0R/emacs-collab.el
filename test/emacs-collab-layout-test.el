;;; emacs-collab-layout-test.el --- Layout tests  -*- lexical-binding: t; -*-

;; Batch Emacs has one dumb frame, but windows can still be split.

(require 'ert)
(require 'cl-lib)
(require 'emacs-collab-layout)
(require 'emacs-collab-test)

(defvar emacs-collab-layout-test--state nil)

(defmacro emacs-collab-layout-test--with-project (spec &rest body)
  "SPEC is (DIR).  Run BODY with a temp project and isolated size state."
  (declare (indent 1))
  `(let* ((,(car spec) (file-name-as-directory
                        (file-truename (emacs-collab-test--tmpdir))))
          (emacs-collab-layout-state-file (expand-file-name "state.eld" ,(car spec)))
          (emacs-collab-layout--sizes nil)
          (emacs-collab-layout--sizes-loaded nil)
          (emacs-collab-layout--projects nil)
          (emacs-collab-layout-last-root nil)
          (emacs-collab-layout-register-lsp nil)
          (emacs-collab--connections nil)
          (unrelated (generate-new-buffer "*unrelated*")))
     (with-temp-file (expand-file-name "main.tex" ,(car spec))
       (insert "\\documentclass{article}\n\\begin{document}\nhi\n\\end{document}\n"))
     (with-temp-file (expand-file-name "other.tex" ,(car spec)) (insert "x\n"))
     (save-window-excursion
       (unwind-protect (progn ,@body)
         (ignore-errors (emacs-collab-layout-quit ,(car spec)))
         (kill-buffer unrelated)
         (dolist (b (buffer-list))
           (when-let* ((f (buffer-file-name b)))
             (when (string-prefix-p ,(car spec) (file-truename f))
               (with-temp-buffer) (with-current-buffer b (set-buffer-modified-p nil))
               (kill-buffer b))))
         (delete-directory ,(car spec) t)))))

(defun emacs-collab-layout-test--dead-p (proc)
  "Wait briefly for PROC to exit (vterm's shell dies on SIGHUP, not at once)."
  (let ((deadline (+ (float-time) 3)))
    (while (and (process-live-p proc) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (not (process-live-p proc))))

(defun emacs-collab-layout-test--roles ()
  (delq nil (mapcar (lambda (w) (window-parameter w 'emacs-collab-role))
                    (window-list nil 'no-minibuf))))

(defun emacs-collab-layout-test--pdf (dir)
  (let ((f (expand-file-name "build/main.pdf" dir)))
    (make-directory (file-name-directory f) t)
    (with-temp-file f (insert "%PDF-1.4\n%%EOF\n"))
    f))

(ert-deftest emacs-collab-layout-test-roles-no-bridge ()
  (emacs-collab-layout-test--with-project (dir)
    (let ((pdf (emacs-collab-layout-test--pdf dir)))
      (emacs-collab-layout-build :root dir :main-file "main.tex" :tree t
                                 :terminal t :pdf pdf)
      (let ((roles (emacs-collab-layout-test--roles)))
        (should (memq 'editor roles))
        (should (memq 'terminal roles))
        (should (memq 'pdf roles))
        (when (featurep 'treemacs)
          (should (emacs-collab-layout-window 'tree))))
      (should (equal (buffer-file-name
                      (window-buffer (emacs-collab-layout-window 'editor)))
                     (expand-file-name "main.tex" dir)))
      (should-not (emacs-collab-layout-window 'preview))
      (should (buffer-live-p (emacs-collab-layout-project-terminal
                              (emacs-collab-layout-project dir))))
      ;; Select commands.
      (emacs-collab-layout-select-terminal)
      (should (eq (window-parameter (selected-window) 'emacs-collab-role) 'terminal))
      (emacs-collab-layout-select-editor)
      (should (eq (window-parameter (selected-window) 'emacs-collab-role) 'editor))
      (emacs-collab-layout-select-pdf)
      (should (eq (window-parameter (selected-window) 'emacs-collab-role) 'pdf))
      (should-error (emacs-collab-layout-select-preview) :type 'user-error))))

(ert-deftest emacs-collab-layout-test-pdf-missing-then-shown ()
  (emacs-collab-layout-test--with-project (dir)
    (let ((pdf (expand-file-name "build/main.pdf" dir)))
      (emacs-collab-layout-build :root dir :main-file "main.tex" :pdf pdf)
      (let ((w (emacs-collab-layout-window 'pdf)))
        (should w)
        (should (string-prefix-p "*emacs-collab-pdf" (buffer-name (window-buffer w)))))
      (emacs-collab-layout-test--pdf dir)
      (emacs-collab-layout-show-pdf)
      (should (equal (buffer-file-name (window-buffer (emacs-collab-layout-window 'pdf)))
                     pdf)))))

(ert-deftest emacs-collab-layout-test-pdf-function ()
  (emacs-collab-layout-test--with-project (dir)
    (emacs-collab-layout-build :root dir :main-file "main.tex"
                               :pdf (lambda () (expand-file-name "build/main.pdf" dir)))
    (should (emacs-collab-layout-window 'pdf))))

(ert-deftest emacs-collab-layout-test-sizes-persist ()
  (emacs-collab-layout-test--with-project (dir)
    (let ((pdf (emacs-collab-layout-test--pdf dir)) w1 th)
      (emacs-collab-layout-build :root dir :main-file "main.tex" :terminal t :pdf pdf)
      (setq w1 (window-total-width (emacs-collab-layout-window 'pdf)))
      ;; Make the pdf pane clearly different from the default.
      (let ((delta (if (> w1 30) -8 8)))
        (window-resize (emacs-collab-layout-window 'pdf) delta t))
      (should-not (= w1 (window-total-width (emacs-collab-layout-window 'pdf))))
      (setq w1 (window-total-width (emacs-collab-layout-window 'pdf)))
      (window-resize (emacs-collab-layout-window 'terminal) -2)
      (setq th (window-total-height (emacs-collab-layout-window 'terminal)))
      (emacs-collab-layout-record-sizes)
      (should (= w1 (plist-get (emacs-collab-layout-sizes dir) :pdf-width)))
      (emacs-collab-layout-quit dir)
      ;; Quit saved to the state file; forget memory and rebuild.
      (should (file-exists-p emacs-collab-layout-state-file))
      (setq emacs-collab-layout--sizes nil emacs-collab-layout--sizes-loaded nil)
      (should (= w1 (plist-get (emacs-collab-layout-sizes dir) :pdf-width)))
      (emacs-collab-layout-build :root dir :main-file "main.tex" :terminal t :pdf pdf)
      (should (= w1 (window-total-width (emacs-collab-layout-window 'pdf))))
      (should (= th (window-total-height (emacs-collab-layout-window 'terminal)))))))

(ert-deftest emacs-collab-layout-test-sizes-per-project ()
  (emacs-collab-layout-test--with-project (dir)
    (let ((other (file-name-as-directory (expand-file-name "sub" dir))))
      (make-directory other)
      (push (list (emacs-collab-layout--canon dir) :pdf-width 17) emacs-collab-layout--sizes)
      (should (= 17 (plist-get (emacs-collab-layout-sizes dir) :pdf-width)))
      (should (floatp (plist-get (emacs-collab-layout-sizes other) :pdf-width))))))

(ert-deftest emacs-collab-layout-test-preview-function-and-quit ()
  (emacs-collab-layout-test--with-project (dir)
    (let* ((pbuf nil) (proc nil) (quit-root nil))
      (emacs-collab-layout-build
       :root dir :main-file "main.tex" :terminal t
       :preview (lambda (_root)
                  (setq pbuf (get-buffer-create "*fake-preview*"))
                  (setq proc (make-process :name "fake-preview" :buffer pbuf
                                           :command '("sleep" "300") :noquery nil))
                  (emacs-collab-layout-register-process proc)
                  pbuf)
       :on-quit (lambda (root) (setq quit-root root)))
      (should (emacs-collab-layout-window 'preview))
      (should (eq (window-buffer (emacs-collab-layout-window 'preview)) pbuf))
      (should (process-live-p proc))
      (let ((term (emacs-collab-layout-project-terminal (emacs-collab-layout-project dir)))
            (other (find-file-noselect (expand-file-name "other.tex" dir))))
        (emacs-collab-layout-quit dir)
        (should (emacs-collab-layout-test--dead-p proc))
        (should-not (buffer-live-p pbuf))
        (should-not (buffer-live-p term))
        (should-not (buffer-live-p other))
        (should-not (get-file-buffer (expand-file-name "main.tex" dir)))
        (should (equal quit-root (emacs-collab-layout--canon dir)))
        (should (buffer-live-p unrelated))
        (should (= 1 (length (window-list nil 'no-minibuf))))
        (should-not (emacs-collab-layout-test--roles))
        (should-not emacs-collab-layout--projects)))))

(ert-deftest emacs-collab-layout-test-preview-xwidget-unavailable ()
  (emacs-collab-layout-test--with-project (dir)
    ;; No graphic display in batch: the spec is skipped, nothing breaks.
    (skip-unless (not (display-graphic-p)))
    (emacs-collab-layout-build :root dir :main-file "main.tex"
                               :preview '(xwidget "http://localhost:1/"))
    (should-not (emacs-collab-layout-window 'preview))
    (should (emacs-collab-layout-window 'editor))))

(ert-deftest emacs-collab-layout-test-preview-failure-closes-pane ()
  (emacs-collab-layout-test--with-project (dir)
    (emacs-collab-layout-build :root dir :main-file "main.tex"
                               :preview (lambda (_) (error "boom")))
    (should-not (emacs-collab-layout-window 'preview))
    (should (emacs-collab-layout-window 'editor))))

(ert-deftest emacs-collab-layout-test-quit-offers-save ()
  (emacs-collab-layout-test--with-project (dir)
    (emacs-collab-layout-build :root dir :main-file "main.tex")
    (let ((main (find-file-noselect (expand-file-name "main.tex" dir)))
          (stray (find-file-noselect (expand-file-name "x.txt" temporary-file-directory)))
          seen)
      (with-current-buffer main (insert "edit"))
      (with-current-buffer stray (insert "edit"))
      (cl-letf (((symbol-function 'save-some-buffers)
                 (lambda (_arg p)
                   (dolist (b (list main stray))
                     (with-current-buffer b
                       (when (funcall p) (push b seen)
                             (save-buffer))))))) 
        (emacs-collab-layout-quit dir))
      (should (equal seen (list main)))
      (should (string-prefix-p "edit"
                               (with-temp-buffer
                                 (insert-file-contents (expand-file-name "main.tex" dir))
                                 (buffer-string))))
      (with-current-buffer stray (set-buffer-modified-p nil))
      (kill-buffer stray))))

(ert-deftest emacs-collab-layout-test-running-terminal-asks ()
  "A shell with a running command makes Emacs ask before it is killed."
  (emacs-collab-layout-test--with-project (dir)
    (let (asked)
      (emacs-collab-layout-build :root dir :main-file "main.tex" :terminal t)
      (let* ((term (emacs-collab-layout-project-terminal (emacs-collab-layout-project dir)))
             (proc (get-buffer-process term)))
        (should (process-live-p proc))
        (cl-letf (((symbol-function 'process-running-child-p) (lambda (_) t))
                  ((symbol-function 'yes-or-no-p) (lambda (_) (setq asked t) t))
                  ((symbol-function 'y-or-n-p) (lambda (_) (setq asked t) t)))
          (emacs-collab-layout--quit-terminal term))
        (should asked)
        (should-not (buffer-live-p term))
        (should (emacs-collab-layout-test--dead-p proc))))))

(ert-deftest emacs-collab-layout-test-idle-terminal-no-query ()
  (emacs-collab-layout-test--with-project (dir)
    (emacs-collab-layout-build :root dir :main-file "main.tex" :terminal t)
    (let* ((term (emacs-collab-layout-project-terminal (emacs-collab-layout-project dir)))
           (proc (get-buffer-process term)))
      (should (process-live-p proc))
      (emacs-collab-layout--quit-terminal term)
      (should (emacs-collab-layout-test--dead-p proc)))))

(ert-deftest emacs-collab-layout-test-tree-closed-on-quit ()
  (emacs-collab-layout-test--with-project (dir)
    (skip-unless (require 'treemacs nil t))
    (emacs-collab-layout-build :root dir :main-file "main.tex" :tree t)
    (should (emacs-collab-layout-window 'tree))
    (emacs-collab-layout-quit dir)
    (should-not (emacs-collab-layout-window 'tree))))

;;; With the loopback bridge

(ert-deftest emacs-collab-layout-test-for-connection-and-quit ()
  (emacs-collab-test--with-session (conn dir)
    (let* ((emacs-collab-layout-state-file (expand-file-name "st.eld" dir))
           (emacs-collab-layout--sizes nil) (emacs-collab-layout--sizes-loaded nil)
           (emacs-collab-layout--projects nil) (emacs-collab-layout-register-lsp nil)
           (unrelated (generate-new-buffer "*unrelated*"))
           (emacs-collab-layout-default-args '(:terminal t))
           (proc (emacs-collab-conn-process conn)))
      (unwind-protect
          (save-window-excursion
            (emacs-collab-layout-for-connection conn)
            (should (emacs-collab-layout-window 'editor))
            (should (emacs-collab-layout-window 'terminal))
            (let ((ebuf (window-buffer (emacs-collab-layout-window 'editor))))
              (should (buffer-file-name ebuf))
              (emacs-collab-test--wait (lambda () (emacs-collab-test--synced-p ebuf)))
              (should (eq (emacs-collab-layout-project-conn (emacs-collab-layout-project dir))
                          conn)))
            (emacs-collab-layout-quit dir)
            (should (emacs-collab-layout-test--dead-p proc))
            (should-not (memq conn emacs-collab--connections))
            (should-not (cl-some (lambda (b) (and (buffer-file-name b)
                                                  (string-prefix-p dir (file-truename (buffer-file-name b)))))
                                 (buffer-list)))
            (should (buffer-live-p unrelated)))
        (kill-buffer unrelated)))))

(ert-deftest emacs-collab-layout-test-ready-hook ()
  (emacs-collab-test--with-session (conn dir)
    ;; The layout can be driven from `emacs-collab-ready-functions'.
    (let ((emacs-collab-layout-state-file (expand-file-name "st.eld" dir))
          (emacs-collab-layout--sizes nil) (emacs-collab-layout--sizes-loaded nil)
          (emacs-collab-layout--projects nil) (emacs-collab-layout-register-lsp nil)
          (emacs-collab-layout-default-args (lambda (_c) '(:terminal nil))))
      (save-window-excursion
        (emacs-collab-layout-for-connection conn)
        (should (emacs-collab-layout-window 'editor))
        (should-not (emacs-collab-layout-window 'terminal))
        (emacs-collab-layout-quit dir)))))

(provide 'emacs-collab-layout-test)
